# Interest income comparison for individual recipients
indiv_interest_all_countries <- filtered_data_all %>%
filter(recipient_type == "Individuals") %>%
group_by(year) %>%
summarize(indiv_interest_all_countries = sum(interest_income, na.rm = TRUE))
indiv_interest_wfp <- data_WFP_all %>%
filter(recipient_type == "Individuals") %>%
select(year, indiv_interest_wfp_all = interest)
interest_indiv_comparison <- indiv_interest_all_countries %>%
left_join(indiv_interest_wfp, by = "year") %>%
mutate(difference = interest_wfp_all - interest_all_countries)
# Interest income comparison for individual recipients
indiv_interest_all_countries <- filtered_data_all %>%
filter(recipient_type == "Individuals") %>%
group_by(year) %>%
summarize(indiv_interest_all_countries = sum(interest_income, na.rm = TRUE))
