# =============================================================================
# 5. DATA COMPARISON: filtered_data_all vs. data_WFP_all
# =============================================================================
# Compares forms 1042-S received by individuals each year between the
# country-level data (summed across all countries) and the aggregate
# entity-type data, to check whether the two sources are consistent.

# Sum forms by individuals per year from filtered_data_all (all countries)
forms_all_countries <- filtered_data_all %>%
  filter(recipient_type == "Individuals") %>%
  group_by(year) %>%
  summarise(forms_all_countries = sum(number_of_forms_1042s, na.rm = TRUE))

# Forms by individuals per year from data_WFP_all (aggregate entity-type totals)
forms_wfp <- data_WFP_all %>%
  filter(recipient_type == "Individuals") %>%
  select(year, forms_wfp_all = number_of_forms_1042s)

# Comparison table
forms_comparison <- forms_all_countries %>%
  left_join(forms_wfp, by = "year") %>%
  mutate(difference = forms_wfp_all - forms_all_countries)

print(forms_comparison)

# Same comparison for corporate recipients
corp_forms_all_countries <- filtered_data_all %>%
  filter(recipient_type == "Corporations") %>%
  group_by(year) %>%
  summarise(forms_all_countries = sum(number_of_forms_1042s, na.rm = TRUE))

corp_forms_wfp <- data_WFP_all %>%
  filter(recipient_type == "Corporations") %>%
  select(year, forms_wfp_all = number_of_forms_1042s)

corp_forms_comparison <- corp_forms_all_countries %>%
  left_join(corp_forms_wfp, by = "year") %>%
  mutate(difference = forms_wfp_all - forms_all_countries)

print(corp_forms_comparison)

# Interest income comparison for individual recipients
indiv_interest_all_countries <- filtered_data_all %>%
  filter(recipient_type == "Individuals") %>%
  group_by(year) %>%
  summarize(indiv_interest_all_countries = sum(interest_income, na.rm = TRUE))

indiv_interest_wfp <- data_WFP_all %>%
  filter(recipient_type == "Individuals") %>%
  select(year, indiv_interest_wfp_all = interest)

interest_indiv_comparison <- indiv_interest_all_countries %>%
  left_join(indiv_interest_wfp, by = "year") %>%
  mutate(difference = indiv_interest_wfp_all - indiv_interest_all_countries)

print(interest_indiv_comparison)

# Interest income comparison for corporate recipients
corp_interest_all_countries <- filtered_data_all %>%
  filter(recipient_type == "Corporations") %>%
  group_by(year) %>%
  summarise(corp_interest_all_countries = sum(interest_income, na.rm = TRUE))

corp_interest_wfp <- data_WFP_all %>%
  filter(recipient_type == "Corporations") %>%
  select(year, corp_interest_wfp_all = interest)

interest_corp_comparison <- corp_interest_all_countries %>%
  left_join(corp_interest_wfp, by = "year") %>%
  mutate(difference = corp_interest_wfp_all - corp_interest_all_countries)

