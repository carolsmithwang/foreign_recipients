read_irscorpdata <- function(url, year, skip=3) {
  temp_file<-tempfile(fileext = ".xlsx")
  download.file(url,temp_file,mode="wb")
  data <- read_excel(temp_file, sheet=1, skip=skip)
  data <- data |> select (Item, 2)
  return(data)
}

