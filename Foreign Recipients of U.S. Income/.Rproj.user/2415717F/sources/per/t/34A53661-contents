read_irspsdata <- function(url, year, skip=3, temp=FALSE) {
  filename <- basename(url)
  if (file.exists(filename)) {
    # If we have already downloaded the file into the current directory, no need to download it again
    data <- read_excel(filename, sheet = 1, skip=skip)
  } else if (temp==TRUE) {
    # Create a temporary file to store the downloaded file
    temp_file <- tempfile(fileext = ".xlsx")
    # Download the file
    download.file(url, temp_file, mode = "wb")  # Use mode = "wb" for binary files
    # Load the Excel file
    data <- read_excel(temp_file, sheet = 1, skip=skip)  # Specify the sheet number or name
    # Clean up: Remove the temporary file
    unlink(temp_file)
  } else {
    # Download the file to the current directory, to save for future use
    download.file(url, filename, mode = "wb")
    data <- read_excel(filename, sheet = 1, skip=skip)
  }
  if (colnames(data)[1] == "Item...1") {
    colnames(data)[1] <- "Item"
  }
  data <- data |> select(Item, matches("all.*industries", ignore.case=TRUE))
  return(data)
}

