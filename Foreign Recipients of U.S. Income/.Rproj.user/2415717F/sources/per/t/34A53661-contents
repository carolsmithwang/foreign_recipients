library(readxl)
library(tidyverse)

read_irsdata <- function(url, year, temp=FALSE) {
  filename <- basename(url)
  if (file.exists(filename)) {
    # If we have already downloaded the file into the current directory, no need to download it again
    data <- read_excel(filename, sheet = 1)
  } else if (temp==TRUE) {
    # Download to a temporary file that we will delete
    temp_file <- tempfile(fileext = ".xlsx")
    # Download the file
    download.file(url, temp_file, mode = "wb")  # Use mode = "wb" for binary files
    # Load the Excel file
    data <- read_excel(temp_file, sheet = 1)
    # Clean up: Remove the temporary file
    unlink(temp_file)
  } else {
    # Download the file to the current directory, to save for future use
    download.file(url, filename, mode = "wb")
    data <- read_excel(filename, sheet = 1)
  }
  colnames(data) <- data[3,]
  data <- data[-c(1, 2, 5, 6), ]
  data <- data %>% select(1:2)
  # Create a new row
  new_row <- data.frame(Item = "Year", Total = year)
  # Add the new row to the data frame
  data <- rbind(new_row, data)
  return(data)
}

