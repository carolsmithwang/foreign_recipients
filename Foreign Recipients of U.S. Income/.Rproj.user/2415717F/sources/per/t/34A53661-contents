filter_values_ps <- function(ps,year,
                             items=c("Number of partnerships","Number of partners",
                                     "Total assets", "Total net income  [3]")) {
  return(
    ps |>
      filter(Item %in% items) |>
      rename(Total=2) |>
#      rename(Total="All\r\nindustries") |>
      mutate(Total=as.numeric(Total)) |>
      mutate(Item = c("num_partnerships", "num_partners", "total_assets", "net_income")) |>
      add_row(Item="year",Total=year) |>
      pivot_wider(names_from = Item, values_from = Total)
  )
}

